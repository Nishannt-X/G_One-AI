# Variable NAMES only. Copy to .env.local (git-ignored) and fill in values there. Never commit real values.
# The scripts in scripts/ load .env.local for you; see docs/RUNBOOK.md.

# --- Gnani (Prisma speech to text, Timbre text to speech). Required. The key stays on the backend. ---
GNANI_API_KEY=
# Optional: GNANI_BASE_URL (default https://api.vachana.ai)
# Optional: GNANI_STT_MODEL (empty = Prisma default model)
# Optional: GNANI_TTS_MODEL (default timbre-v2.5; voices in G_ONE_LANGUAGES must belong to this model)

# --- Agent brain: any OpenAI-compatible /chat/completions endpoint with tool calling. Groq is the default choice. ---
G_ONE_LLM_BASE_URL=
G_ONE_LLM_API_KEY=
G_ONE_LLM_MODEL=

# --- Farmer memory ---
# Secret that turns a phone number into the CallerKey memory is stored under. Base64 of at least 32 random bytes:
#   openssl rand -base64 32
# Losing or changing it makes every saved memory stop matching its caller. Never commit it.
G_ONE_MEMORY_HMAC_KEY=
# Sent as the X-Access-Code header to open /api/memory/**. Blank leaves that endpoint closed (403).
G_ONE_ACCESS_CODE=
# Optional: G_ONE_MEMORY_STORE=sqlite (or in-memory)   G_ONE_DATA_DIR=./data   G_ONE_MEMORY_SEED_FILE=classpath:memory/seed-suresh.json
# Optional, local dev only: G_ONE_MEMORY_DEV_OPEN=true serves /api/memory/** to direct loopback requests.

# --- Server ---
PORT=8080

# --- Stretch only: real phone calls through Twilio. The browser call simulator needs none of these. ---
# The backend does not read them yet; they belong to issue #17 (stretch).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# Public https host of the tunnel (for example your ngrok static domain), used for the Twilio webhook and wss stream.
# G_ONE_PUBLIC_BASE_URL=
# Demo buyer numbers only, never committed. Format: buyerId=+91...;buyerId2=+91...
# G_ONE_BUYER_PHONES=

# --- Optional tuning ---
# G_ONE_LANGUAGES=hi-IN:Hindi:Nalini,en-IN:English:Kaveri,ta-IN:Tamil:Asmita,kn-IN:Kannada:Saanvi
# G_ONE_MANDI_SNAPSHOT_FILE=   (path to a dated snapshot JSON; default is the bundled development sample)
# GNANI_TIMEOUT_SECONDS=30   G_ONE_LLM_TIMEOUT_SECONDS=30   (backend/src/main/resources/application.yml lists every setting)
