# Variable NAMES only. Put real values in an untracked .env (ignored by git) or export them in your shell.
# Load for a local run with:  set -a; . ./.env; set +a; mvn spring-boot:run
# Former AISETU_* names still work as fallbacks. A G_ONE_* name that is set wins even when blank, so do not leave one
# blank while relying on its old name; see DEMO.md "Renamed configuration".

# Gnani (Prisma STT + Timbre TTS). The key stays on the backend; it is never sent to browsers.
GNANI_API_KEY=
# Optional: GNANI_BASE_URL (default https://api.vachana.ai)
# Optional: GNANI_STT_MODEL  (empty = documented default Prisma v2.5; set to the model your account was probed with)
# Optional: GNANI_TTS_MODEL  (default timbre-v2.5; voices in G_ONE_LANGUAGES must belong to this model)

# Translation: any OpenAI-compatible /chat/completions service. No provider or model is assumed.
G_ONE_LLM_BASE_URL=
G_ONE_LLM_API_KEY=
G_ONE_LLM_MODEL=

# Strongly recommended when the demo is reachable from the internet: required to create a room.
# (If a former AISETU_ACCESS_CODE is still set, leave this filled in or unset: blank here plus a real old code stops startup.)
G_ONE_ACCESS_CODE=

# Optional tuning
# G_ONE_LANGUAGES=hi-IN:Hindi:Nalini,en-IN:English:Kaveri,ta-IN:Tamil:Asmita,kn-IN:Kannada:Saanvi
# G_ONE_MANDI_SNAPSHOT_FILE=   (path to your dated snapshot JSON; default is the bundled development sample)

# Optional live AGMARKNET price (public, no key) for ONE variety at ONE market. Set ALL six or none; not together with
# G_ONE_MANDI_SNAPSHOT_FILE. Example (rice, Common, Burdwan APMC, West Bengal): see DEMO.md "Live market price".
# G_ONE_AGMARKNET_MARKET_ID=   G_ONE_AGMARKNET_STATE_ID=   G_ONE_AGMARKNET_COMMODITY_ID=
# G_ONE_AGMARKNET_COMMODITY=   G_ONE_AGMARKNET_MARKET=     G_ONE_AGMARKNET_VARIETY=
# Optional: G_ONE_AGMARKNET_TIMEOUT_SECONDS=5  G_ONE_AGMARKNET_MAX_AGE_DAYS=3  G_ONE_AGMARKNET_CACHE_MINUTES=30
# G_ONE_MAX_TURNS_PER_ROOM=50  G_ONE_MAX_ROOMS=20  G_ONE_ROOM_IDLE_MINUTES=120  PORT=8080
